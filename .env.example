# Copy to .env.local and fill in. Never put secret / service_role keys here:
# every VITE_* variable is bundled into the browser build.
#
# Local stack: run `npm run db:start`, then copy "Project URL" and the
# "Publishable" key from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
